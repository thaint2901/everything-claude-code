# ── thaint-setup/.env.example ────────────────────────────────────────────────
# Copy to .env (same directory) and fill in real values, then re-run
# setup_claude.sh.  Values are loaded by the setup script and written into the
# ~/.claude/settings.json `env` block.  Only the keys listed below are applied;
# a per-plan ANTHROPIC gateway block does NOT live here — it lives in
# ~/coding_plan/<plan>.env and is consumed only by the <plan>_clauded shell
# helpers, so plain `claude` keeps routing to your Anthropic subscription.
#
# Format: KEY="value" one per line.  `#` starts a comment.  A key left empty
# is treated as unset (server stays disabled).  Real shell exports still win
# over this file when you re-run the script.
#
# DO NOT COMMIT THIS FILE — it holds real credentials and is gitignored.

# MCP / tool keys -> written to ~/.claude/settings.json env
# context7 (docs lookup; optional — anonymous tier if unset)
CONTEXT7_API_KEY=""
# exa web search
EXA_API_KEY=""
# firecrawl web search / scrape
FIRECRAWL_API_KEY=""
# telegram notification hook (only used if both are non-empty)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Per-plan gateway blocks -> ~/coding_plan/<plan>.env (NOT here)
# Each <plan>_clauded wrapper sources its own ~/coding_plan/<plan>.env:
#   ocgo_clauded -> ~/coding_plan/opencode_go.env
#   ali_clauded  -> ~/coding_plan/alibaba.env
# Format is the same KEY="value" lines — e.g.
#   ANTHROPIC_BASE_URL="https://model-gateway.tensoredge.cc"
#   ANTHROPIC_AUTH_TOKEN=""
#   ANTHROPIC_MODEL="opencode/deepseek-v4-flash[1m]"
#   ANTHROPIC_DEFAULT_OPUS_MODEL="opencode/glm-5.2[1m]"
#   ANTHROPIC_DEFAULT_SONNET_MODEL="opencode/deepseek-v4-flash[1m]"
#   ANTHROPIC_DEFAULT_HAIKU_MODEL="opencode/deepseek-v4-flash[1m]"
#   CLAUDE_CODE_SUBAGENT_MODEL="opencode/deepseek-v4-flash[1m]"
#   CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # DeepSeek thinking-only streams
#                                               # (see litellm issue, 2026-08-31)
#
# Those vars are sourced only inside <plan>_clauded and never written to
# settings.json, so plain `claude` stays on your Anthropic account.
