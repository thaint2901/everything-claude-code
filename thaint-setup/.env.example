# ── thaint-setup/.env.example ────────────────────────────────────────────────
# Copy to .env (same directory) and fill in real values, then re-run
# setup_claude.sh.  Values are loaded by the setup script: shared keys go to
# the ~/.claude/settings.json `env` block; plan gateway blocks (the
# `<PLAN>_ANTHROPIC_*` vars) are read only by the <plan>_clauded shell
# helpers, which strip the prefix before launching claude — so plain `claude`
# keeps routing to your Anthropic subscription.
#
# Format: KEY="value" one per line.  `#` starts a comment.  A key left empty
# is treated as unset (server stays disabled).  Real shell exports still win
# over this file when you re-run the script.
#
# DO NOT COMMIT THIS FILE — it holds real credentials and is gitignored.

# Shared keys -> written to ~/.claude/settings.json env (plain claude too)
# context7 (docs lookup; optional — anonymous tier if unset)
CONTEXT7_API_KEY=""
# exa web search
EXA_API_KEY=""
# firecrawl web search / scrape
FIRECRAWL_API_KEY=""
# telegram notification hook (only used if both are non-empty)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Plan gateway blocks -> read by <plan>_clauded only, prefix stripped
# OPENCODE_GO_ -> ocgo_clauded()  (opencode_go plan; add ALIBABA_ for alibaba)
# DEEPSEEK_ -> ds_clauded()  (deepseek plan, direct to api.deepseek.com/anthropic)
# Lines may be bare "KEY=" or "export KEY=" (old ~/coding_plan/*.env format);
# the wrapper strips both the optional "export" and the <PLAN>_ prefix.
# Each var is sourced only inside the wrapper and never written to
# settings.json, so plain `claude` stays on your Anthropic account.
OPENCODE_GO_ANTHROPIC_BASE_URL=""
OPENCODE_GO_ANTHROPIC_AUTH_TOKEN=""
OPENCODE_GO_ANTHROPIC_MODEL=""
OPENCODE_GO_ANTHROPIC_DEFAULT_OPUS_MODEL=""
OPENCODE_GO_ANTHROPIC_DEFAULT_SONNET_MODEL=""
OPENCODE_GO_ANTHROPIC_DEFAULT_HAIKU_MODEL=""
OPENCODE_GO_CLAUDE_CODE_SUBAGENT_MODEL=""
# DeepSeek thinking-only streams via the gateway; set 1 to make it plain text
OPENCODE_GO_CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"

# deepseek: direct to DeepSeek's own Anthropic-compatible endpoint (no
# third-party gateway in between), per api-docs.deepseek.com/quick_start/
# agent_integrations/claude_code. deepseek-flash = DeepSeek-V4.1-Flash.
# NOT carrying OPENCODE_GO's CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 here —
# that fix targeted a gateway-relay symptom, unverified as needed on this
# direct endpoint (anthropics/claude-code#68551 reports it does NOT fix
# DeepSeek thinking-related hangs anyway).
#
# Verified 2026-09-11 by curl'ing api.deepseek.com/anthropic directly
# (deepseek-flash, real key):
#   - #65863 (Agent()/subagent -> 400 "thinking options type cannot be
#     disabled when reasoning_effort is set"): curl'd the exact repro
#     (thinking:{type:disabled} + reasoning_effort:high) -> 200 clean text,
#     matching every community curl repro on that issue. The issue itself
#     was auto-closed by a stale-bot after inactivity, no maintainer
#     confirmed a fix — status is genuinely unknown, not resolved. Root
#     cause (per issue discussion) is something Claude Code's Agent
#     subprocess sends that plain curl can't replicate, so this remains
#     UNVERIFIED for the actual CLAUDE_CODE_SUBAGENT_MODEL path — this
#     sandbox's permission classifier blocks spawning a nested `claude`
#     process ("Create Unsafe Agents"), so the real harness path couldn't
#     be exercised. Test with a live Task/Agent spawn once ds_clauded runs
#     interactively.
#   - #68551 (high/xhigh effort -> thinking:{type:adaptive} -> hangs on
#     some DeepSeek reasoning models): curl'd thinking:{type:adaptive} ->
#     200 in <1s, no hang. Only a single-turn text probe though, not the
#     multi-tool-call harness traffic the report described — treat as a
#     good sign, not a guarantee.
#   - Bonus finding (not from either issue): with a very small max_tokens
#     (16), deepseek-flash's default (on) thinking mode returned a turn
#     containing ONLY a thinking block, no text (stop_reason=max_tokens) —
#     the literal "thinking-only stream" symptom the OPENCODE_GO fix
#     targeted, reproduced with NO gateway in the path. At a realistic
#     max_tokens (1000) the same prompt resolved thinking -> text normally.
#     Real Claude Code requests budget far more than 16 tokens, so this is
#     unlikely in practice, but a subagent call with an unusually tight
#     budget or a very long thinking chain could still hit it — if you see
#     "no complete data" errors, this is the first thing to suspect.
# If either GitHub issue reproduces for real, add the matching var
# (CLAUDE_CODE_DISABLE_THINKING=1 is #68551's community workaround) below.
DEEPSEEK_ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
DEEPSEEK_ANTHROPIC_AUTH_TOKEN=""
DEEPSEEK_ANTHROPIC_MODEL="deepseek-flash[1m]"
DEEPSEEK_ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-flash[1m]"
DEEPSEEK_ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-flash[1m]"
DEEPSEEK_ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-flash"
DEEPSEEK_CLAUDE_CODE_SUBAGENT_MODEL="deepseek-flash"
DEEPSEEK_CLAUDE_CODE_EFFORT_LEVEL="max"
DEEPSEEK_CLAUDE_CODE_AUTO_COMPACT_WINDOW="786432"
